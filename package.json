{
  "name": "ubwenzi-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22 <23", "npm": ">=10" },
  "workspaces": [
    "frontend/web",
    "frontend/mobile",
    "backend/api",
    "backend/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run web:dev",
    "build": "nx run-many -t build --all",
    "typecheck": "nx run-many -t typecheck --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "test:integration": "nx run-many -t test:integration --all",
    "graph": "nx graph"
  },
  "devDependencies": { "nx": "^21.6.0", "typescript": "~5.8.3" }
}