{
  "name": "ubwenzi-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22 <23", "npm": ">=10" },
  "workspaces": [
    "frontend/web",
    "frontend/mobile",
    "backend/api",
    "backend/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run web:dev",
    "build": "nx run web:build",
    "typecheck": "nx run web:typecheck",
    "lint": "npm run lint --workspace @ubwenzi/web",
    "test": "npm run test --workspace @ubwenzi/web",
    "graph": "nx graph"
  },
  "devDependencies": { "nx": "^21.6.0", "typescript": "~5.8.3" }
}